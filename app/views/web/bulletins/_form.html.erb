<%= form_with model: bulletin, class: "contents" do |form| %>
  <div class="my-5">
    <%= form.label :title %>

    <%= form.text_field :title,
                        class: "mt-2 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
  </div>

  <div class="my-5">
    <%= form.label :description %>

    <%= form.text_area :description, rows: 4,
                        class: "mt-2 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
  </div>

  <div class="my-5">
    <%= form.label :category_id, Bulletin.human_attribute_name(:category) %>

    <%= form.collection_select :category_id, categories, :id, :name, { include_blank: true },
                              class: "mt-2 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
  </div>

  <% if form.object.image_attachment %>
    <%= image_tag form.object.image, alt: form.object.title,
                  class: "mb-2 rounded-md border border-gray-200 p-1" %>
  <% end %>

  <div class="my-5">
    <%= form.label :image %>

    <%= form.file_field :image, class: "mt-2 block w-full" %>
  </div>

  <%= form.submit class: "cursor-pointer rounded-md bg-blue-600 px-3.5 py-2.5 font-medium text-white hover:bg-blue-500" %>
<% end %>
