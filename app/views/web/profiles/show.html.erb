<% content_for :title, t(".my_bulletins") %>

<%= link_to t(".add_bulletin"), new_bulletin_path, class: "text-blue-600 hover:underline" %>

<table class="mt-4 w-full text-left">
  <thead>
    <tr>
      <th scope="col" class="border-b border-gray-200 py-2 font-medium"><%= t(".name") %></th>
      <th scope="col" class="border-b border-gray-200 py-2 font-medium"><%= t(".state") %></th>
      <th scope="col" class="border-b border-gray-200 py-2 font-medium"><%= t(".actions") %></th>
    </tr>
  </thead>

  <tbody>
    <% @bulletins.each do |bulletin| %>
      <tr>
        <td class="border-b border-gray-100 py-2"><%= bulletin.title %></td>
        <td class="border-b border-gray-100 py-2"><%= bulletin.aasm.human_state %></td>
        <td class="border-b border-gray-100 py-2">
          <div class="flex flex-wrap gap-2">
            <%= link_to t(".show"), bulletin_path(bulletin), class: "text-blue-600 hover:underline" %>
            <%= link_to t(".edit"), edit_bulletin_path(bulletin), class: "text-blue-600 hover:underline" %>

            <% if bulletin.may_to_moderate? %>
              <%= button_to t(".to_moderate"), to_moderate_bulletin_path(bulletin), method: :patch,
                            class: "cursor-pointer text-blue-600 hover:underline" %>
            <% end %>

            <% if bulletin.may_archive? %>
              <%= button_to t(".archive"), archive_bulletin_path(bulletin), method: :patch,
                            form: { data: { turbo_confirm: t(".confirm_archive") } },
                            class: "cursor-pointer text-red-600 hover:underline" %>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
