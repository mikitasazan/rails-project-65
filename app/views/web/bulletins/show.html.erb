<nav class="text-sm text-gray-500">
  <%= link_to t(".all_bulletins"), root_path, class: "hover:underline" %>
</nav>

<article class="mt-6 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
  <% if @bulletin.image.attached? %>
    <%= image_tag @bulletin.image, alt: @bulletin.title, class: "mb-4 rounded-md" %>
  <% end %>

  <h1 class="mb-4 text-2xl font-bold"><%= @bulletin.title %></h1>

  <p><%= simple_format(@bulletin.description) %></p>

  <p class="mt-6 text-sm text-gray-500">
    <span class="mr-2"><%= @bulletin.user.name %></span>
    <span><%= distance_of_time_in_words_to_now(@bulletin.created_at) %></span>
  </p>
</article>
